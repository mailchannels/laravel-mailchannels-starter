# Copy to .env and fill in. Placeholders only: never commit real keys.

APP_NAME="MailChannels Starter"
APP_ENV=local
# Framework secret key: generate with `php artisan key:generate`.
APP_KEY=
APP_DEBUG=true
# Public base URL; used to build the links in verification and reset emails.
APP_URL=http://127.0.0.1:3006

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=sync
CACHE_STORE=database
FILESYSTEM_DISK=local

# --- Email: MailChannels Email API ---
MAIL_MAILER=mailchannels
MAILCHANNELS_API_KEY=your-mailchannels-api-key
# Real API: https://api.mailchannels.net/tx/v1
# Local stub (php -S 127.0.0.1:4006 stub/server.php): http://127.0.0.1:4006/tx/v1
MAILCHANNELS_API_BASE_URL=http://127.0.0.1:4006/tx/v1
MAIL_FROM_EMAIL=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"
CONTACT_TO_EMAIL=support@example.com
# Optional: pin the webhook verification key instead of fetching it from the API.
# For the local stub this is the TEST-ONLY key in stub/src/TestKeys.php.
MAILCHANNELS_WEBHOOK_PUBLIC_KEY=
